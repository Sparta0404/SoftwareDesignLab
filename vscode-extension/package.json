{
  "name": "svg-vscode",
  "displayName": "SVG 文件标记与大纲",
  "description": "在资源管理器中为 .svg 文件显示 [] 标记，并在大纲视图中展示 SVG 元素层级。",
  "version": "0.1.0",
  "private": true,
  "license": "ISC",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:integration": "npm run compile && tsc -p tsconfig.test.json && node ./out-test/test/integration/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^12.0.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "htmlparser2": "^9.1.0"
  }
}
